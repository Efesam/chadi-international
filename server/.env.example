# Copy this file to .env and fill in your own values.
# It's loaded automatically when you run `npm run dev` or `npm start`.

# Set to "production" when deploying for real. This enables stricter startup
# checks (e.g. the server refuses to start without AUTH_SECRET set).
# NODE_ENV=production

# Get this from your Paystack dashboard: Settings -> API Keys & Webhooks.
# Required for donation payments on the Donate page to verify successfully.
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxx

# Optional second payment option for international/diaspora donors who'd
# rather not enter a card through Paystack - a "Pay with PayPal" button
# appears on the Donate modal once both this and the client's
# VITE_PAYPAL_CLIENT_ID are set. Get these from developer.paypal.com -> your
# app. One-time USD donations only (no PayPal equivalent of Hope Alive
# Circle's monthly Paystack subscriptions yet).
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# PAYPAL_ENV=sandbox

# Signs admin session tokens. Set this to a long random string before
# deploying anywhere real - without it, an insecure built-in default is used
# (and the server refuses to start at all when NODE_ENV=production).
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET=

# Seeds the very first admin account (only used the first time the server
# starts, before users.json exists). Defaults shown in README if left unset.
# ADMIN_EMAIL=admin@chadi-international.org
# ADMIN_PASSWORD=ChadiAdmin!2026

# PORT=4000

# This API's own public URL, used to build absolute links in emails it sends
# (currently just the newsletter unsubscribe link in broadcast emails).
# Defaults to http://127.0.0.1:<PORT> for local dev.
# API_URL=https://api.chadi-international.org

# The public CLIENT site's URL (not the API's) - used to build article links
# in the RSS feed at /feed.xml. Defaults to a placeholder domain, same as
# client/scripts/generate-sitemap.js does, until the real domain is decided.
# SITE_URL=https://www.chadi-international.org

# Comma-separated list of origins allowed to call this API (your production
# client domain, e.g. https://www.chadi-international.org). Left unset, every
# origin is allowed - fine for local dev, but set this before going live.
# ALLOWED_ORIGINS=https://www.chadi-international.org

# Cloudinary account, used to store admin-uploaded images/videos in the
# cloud instead of on local disk. Without these set, uploads are written to
# server/uploads/ on local disk instead - fine for a VPS with persistent
# storage, but those files are lost on every redeploy on ephemeral hosts
# (Render, Railway, Heroku, etc), so set this before deploying there.
# Get these from your Cloudinary dashboard: Settings -> API Keys.
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# SMTP settings for sending real emails (currently used for password reset).
# Works with any SMTP provider - Gmail (with an app password), Resend,
# SendGrid, Mailgun, Postmark, etc. Without these set, reset links are
# logged to the console instead, which still works fine for local testing.
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=587
# SMTP_USER=resend
# SMTP_PASS=your_smtp_password_or_api_key
# SMTP_FROM=CHADI International <no-reply@chadiinternational.org>

