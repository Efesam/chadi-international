# Copy this file to .env and fill in your own values.

# Paystack public key, used by the Donate page's checkout popup.
# Get this from your Paystack dashboard: Settings -> API Keys & Webhooks.
VITE_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxx

# Only needed if your API isn't running at the default http://127.0.0.1:4000/api
# VITE_API_URL=http://127.0.0.1:4000/api
