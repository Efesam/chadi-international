# Copy this file to .env and fill in your own values.

# Paystack public key, used by the Donate page's checkout popup.
# Get this from your Paystack dashboard: Settings -> API Keys & Webhooks.
VITE_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxx

# Only needed if your API isn't running at the default http://127.0.0.1:4000/api
# VITE_API_URL=http://127.0.0.1:4000/api

# Your production domain (no trailing slash). Used to generate canonical URLs
# and Open Graph/Twitter share tags. Leave unset in local dev.
# VITE_SITE_URL=https://www.chadi-international.org

# All of the below are entirely optional - each feature they unlock stays
# quietly off (no console errors, no partial/broken UI) until its variable
# is set. See README.md for what each one turns on and where to get it.
# VITE_SENTRY_DSN=
# VITE_PLAUSIBLE_DOMAIN=
# VITE_PAYPAL_CLIENT_ID=

# Channel id (starts with "UC...") for the "See Us in Action" YouTube feed
# on the homepage - find it under a channel's About page -> Share -> Copy
# channel ID. Leave unset to skip that section entirely.
# VITE_YOUTUBE_CHANNEL_ID=
