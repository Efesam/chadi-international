# Loaded automatically by Vitest (Vite's built-in mode-specific env file),
# regardless of whether a real client/.env exists - so tests behave the same
# locally and in CI, which has no .env (it's gitignored). Dummy values only;
# nothing here is a real credential.
VITE_PAYSTACK_PUBLIC_KEY=pk_test_dummy_key_for_vitest
